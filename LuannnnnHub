-- [ FUNÇÕES CORE ]
local function MudarPatente(novaPatente, cor)
    local char = LocalPlayer.Character
    if char then
        local head = char:FindFirstChild("Head")
        local billboard = head and head:FindFirstChildOfClass("BillboardGui") or char:FindFirstChildOfClass("BillboardGui")
        if billboard then
            local labels = {}
            for _, v in pairs(billboard:GetDescendants()) do if v:IsA("TextLabel") then table.insert(labels, v) end end
            table.sort(labels, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
            if #labels >= 2 then
                labels[1].TextColor3 = cor
                labels[2].Text = novaPatente
                labels[2].TextColor3 = cor
                if labels[3] then labels[3].TextColor3 = cor end
            end
        end
    end
end

local function DarDinheiro(valor)
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local cash = stats:FindFirstChild("Money") or stats:FindFirstChild("Dinheiro") or stats:FindFirstChild("Cash")
        if cash then cash.Value = cash.Value + valor end
    end
end

local function EnviarNoChat(txt)
    local formatado = txt:sub(1,1):upper() .. txt:sub(2):lower()
    local chatEvent = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chatEvent and chatEvent:FindFirstChild("SayMessageRequest") then
        chatEvent.SayMessageRequest:FireServer(formatado, "All")
    else
        game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(formatado)
    end
end

