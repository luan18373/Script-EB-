                        if obj.Size.Y > obj.Size.X * 1.5 then
                            obj.Size = obj.Size + Vector3.new(0.5, 0, 0.5)
                        else
                            local inc = (num == 4) and 2.5 or 4
                            obj.Size = obj.Size + Vector3.new(inc, 0, inc)
                        end
                    end
                end
            end
        end
    end
end

local function DesativarHB(num)
    local pontos = Tabelas[num]
    for obj, s in pairs(backupSizes) do
        if obj and obj.Parent then
            for _, pos in pairs(pontos) do
                if (obj.Position - pos).Magnitude < 21 then
                    obj.Size = s
                    backupSizes[obj] = nil
                end
            end
        end
    end
end

local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = gui.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

